theme_override_colors/font_color = Color(0.95, 0.92, 0.13, 1)
theme_override_font_sizes/font_size = 80
text = "Pacmaze"
horizontal_alignment = 1

[node name="Instructions" type="Label" parent="Center/VBox"]
custom_minimum_size = Vector2(720, 0)
