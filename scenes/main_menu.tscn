text = "1. Use as setas para iniciar o jogo e movimentar o pac.
2. O movimento na direção selecionada só para quando o pac atinge um obstáculo.
3. O pac deve atravessar o labirinto evitando os fantasmas e chegar ao portal luminoso."
autowrap_mode = 3

[node name="Buttons" type="VBoxContainer" parent="Center/VBox"]
