[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/game.gd" id="1_game"]
[ext_resource type="Script" path="res://scripts/pause_menu.gd" id="2_pause"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_topbar"]
bg_color = Color(0.02, 0.03, 0.08, 0.8)
border_width_bottom = 2
border_color = Color(0, 0.63, 0.9, 0.35)
shadow_color = Color(0, 0, 0, 0.35)
shadow_size = 8

[node name="Game" type="Node2D"]
script = ExtResource("1_game")

[node name="LevelContainer" type="Node2D" parent="."]

[node name="Camera2D" type="Camera2D" parent="."]

[node name="HUD" type="CanvasLayer" parent="."]

[node name="TopBarBackground" type="Panel" parent="HUD"]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 56.0
grow_horizontal = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_topbar")

[node name="TopBar" type="HBoxContainer" parent="HUD"]
anchors_preset = 10
anchor_right = 1.0
offset_left = 24.0
offset_top = 10.0
offset_right = -24.0
offset_bottom = 46.0
grow_horizontal = 2
theme_override_constants/separation = 40

[node name="LevelLabel" type="Label" parent="HUD/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.92, 0.13, 1)
text = "Fase 1/8"

[node name="MovesLabel" type="Label" parent="HUD/TopBar"]
unique_name_in_owner = true
layout_mode = 2
text = "Movimentos: 0"

[node name="TimeLabel" type="Label" parent="HUD/TopBar"]
unique_name_in_owner = true
layout_mode = 2
text = "Tempo: 0s"

[node name="ScoreLabel" type="Label" parent="HUD/TopBar"]
unique_name_in_owner = true
layout_mode = 2
text = "Pontuação: 0"

[node name="KeysBar" type="HBoxContainer" parent="HUD/TopBar"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="Spacer" type="Control" parent="HUD/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="HintLabel" type="Label" parent="HUD/TopBar"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.6, 0.6, 1)
text = "Espaço: reiniciar    Esc: pausar"

[node name="Instructions" type="CenterContainer" parent="HUD"]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="HUD/Instructions"]
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="HUD/Instructions/Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="InstructionsLabel" type="Label" parent="HUD/Instructions/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="StartHint" type="Label" parent="HUD/Instructions/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.92, 0.13, 1)
text = "Pressione qualquer botão ou deslize para começar"
horizontal_alignment = 1

[node name="CompletePanel" type="CenterContainer" parent="HUD"]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="HUD/CompletePanel"]
layout_mode = 2

[node name="CompleteLabel" type="Label" parent="HUD/CompletePanel/Panel"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 40
text = "Fase concluída!"
horizontal_alignment = 1

[node name="PauseMenu" type="CanvasLayer" parent="."]
process_mode = 3
layer = 10
script = ExtResource("2_pause")

[node name="Dim" type="ColorRect" parent="PauseMenu"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01, 0.015, 0.04, 0.7)

[node name="Center" type="CenterContainer" parent="PauseMenu"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="PauseMenu/Center"]
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="PauseMenu/Center/Panel"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="PauseMenu/Center/Panel/VBox"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 44
text = "Pausado"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="PauseMenu/Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Continuar"

[node name="RestartButton" type="Button" parent="PauseMenu/Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Reiniciar fase"

[node name="MenuButton" type="Button" parent="PauseMenu/Center/Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Menu principal"
