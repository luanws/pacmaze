[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/level.gd" id="1_level"]
[ext_resource type="TileSet" path="res://assets/walls_tileset.tres" id="2_tileset"]
[ext_resource type="PackedScene" path="res://scenes/pill.tscn" id="3_pill"]
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="4_player"]

[node name="Level" type="Node2D"]
script = ExtResource("1_level")

[node name="Walls" type="TileMapLayer" parent="."]
tile_set = ExtResource("2_tileset")

[node name="Portals" type="Node2D" parent="."]

[node name="Pill" parent="." instance=ExtResource("3_pill")]

[node name="Player" parent="." instance=ExtResource("4_player")]

[node name="Ghosts" type="Node2D" parent="."]
